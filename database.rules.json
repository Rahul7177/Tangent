{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      ".read": "auth != null",
      "$username": {
        ".write": "auth != null && ((!data.exists() && newData.child('ownerId').val() === auth.uid) || data.child('ownerId').val() === auth.uid)",
        ".validate": "newData.hasChildren(['id', 'ownerId', 'name', 'username', 'phone']) && newData.child('username').val() === $username && newData.child('ownerId').val() === auth.uid"
      }
    },
    "presence": {
      ".read": "auth != null",
      "$username": {
        ".write": "auth != null && root.child('users').child($username).child('ownerId').val() === auth.uid && newData.isBoolean()",
        ".validate": "newData.isBoolean()"
      }
    },
    "messages": {
      "$chatId": {
        "$messageId": {
          ".write": "auth != null && !data.exists() && root.child('users').child(newData.child('sender').val()).child('ownerId').val() === auth.uid",
          ".validate": "newData.hasChildren(['id', 'chatId', 'sender', 'senderUid', 'kind', 'text', 'createdAt', 'receipt', 'reactions']) && newData.child('chatId').val() === $chatId && newData.child('senderUid').val() === auth.uid && newData.child('text').val().length <= 2000"
        }
      }
    },
    "inbox": {
      "$username": {
        ".read": "auth != null && root.child('users').child($username).child('ownerId').val() === auth.uid",
        "$messageId": {
          ".write": "auth != null && !data.exists() && root.child('users').child(newData.child('sender').val()).child('ownerId').val() === auth.uid && newData.child('to').val() === $username",
          ".validate": "newData.child('to').val() === $username && newData.child('senderUid').val() === auth.uid"
        }
      }
    },
    "requests": {
      "$username": {
        ".read": "auth != null && root.child('users').child($username).child('ownerId').val() === auth.uid",
        "$requestId": {
          ".write": "auth != null && !data.exists() && root.child('users').child(newData.child('from').val()).child('ownerId').val() === auth.uid && newData.child('to').val() === $username",
          ".validate": "newData.hasChildren(['id', 'from', 'to', 'createdAt', 'status']) && newData.child('status').val() === 'pending'"
        }
      }
    },
    "requestsOut": {
      "$username": {
        ".read": "auth != null && root.child('users').child($username).child('ownerId').val() === auth.uid",
        "$requestId": {
          ".write": "auth != null && root.child('users').child($username).child('ownerId').val() === auth.uid",
          ".validate": "newData.child('from').val() === $username"
        }
      }
    },
    "requestEvents": {
      "$username": {
        ".read": "auth != null && root.child('users').child($username).child('ownerId').val() === auth.uid",
        "$requestId": {
          ".write": "auth != null && root.child('users').child(newData.child('from').val()).child('ownerId').val() === auth.uid && newData.child('to').val() === $username",
          ".validate": "newData.child('type').val() === 'accepted'"
        }
      }
    }
  }
}