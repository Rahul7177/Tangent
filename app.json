{
  "expo": {
    "name": "Tangent",
    "slug": "tangent-chat",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#FFFFFF"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.tangent.chat",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Unlock Whisper — your per-chat hidden space.",
        "NSCameraUsageDescription": "Scan a friend's profile QR to add them on Tangent.",
        "NSContactsUsageDescription": "Find your contacts who are already on Tangent."
      }
    },
    "android": {
      "package": "app.tangent.chat",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["USE_BIOMETRIC", "USE_FINGERPRINT", "CAMERA", "READ_CONTACTS"],
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-camera",
        { "cameraPermission": "Scan a friend's profile QR to add them on Tangent." }
      ],
      [
        "expo-contacts",
        { "contactsPermission": "Find your contacts who are already on Tangent." }
      ]
    ]
  }
}
